# ============================================================================
# AQUA AI Platform 环境变量模板
# ----------------------------------------------------------------------------
# 使用方法：cp .env.example .env 后逐项填写。所有密钥/密码务必使用随机强值。
# 本文件已列入 .gitignore（.env 严禁提交到仓库）。
#
# 变量按服务分组；两服务共用的变量标注【共用】。
# 生成随机值：
#   随机令牌   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   Fernet密钥 python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   bcrypt哈希 见下方「管理员密码」说明
# ============================================================================


# ============================================================================
# 1. 管理员密码（Gateway 与 Platform 管理后台共用）
# ============================================================================
# 优先级：ACU_ADMIN_PASSWORD_HASH（bcrypt 哈希，推荐） > ACU_ADMIN_PASSWORD（明文，
# 恒定时间比较回退）。两者只配置其一即可，同时配置时 HASH 优先。
#
# 生成 bcrypt 哈希（12 rounds）：
#   python3 -c "import bcrypt; print(bcrypt.hashpw('你的密码'.encode(), bcrypt.gensalt(rounds=12)).decode())"
#
# 注意：Gateway 的 Admin API（/gw/admin/*）要求必须配置 ACU_ADMIN_PASSWORD_HASH，
# 否则启动即报错；SQLAdmin 面板在未配置 HASH 时才回退校验 ACU_ADMIN_PASSWORD。
ACU_ADMIN_PASSWORD_HASH=
ACU_ADMIN_PASSWORD=


# ============================================================================
# 2. 服务间认证与加密密钥
# ============================================================================
# 【共用】Platform → Gateway 内部服务令牌。两侧必须完全一致，
# 否则平台调用网关管理 API（如发放密钥）将全部返回 401。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AQUA_PLATFORM_TOKEN=

# 【共用】SQLAdmin 面板（/gw/dbadmin、/platform/dbadmin）的 Session 签名密钥。
# 未设置时使用临时随机值，重启后所有面板登录会话失效。
ADMIN_SESSION_SECRET=

# Platform 管理会话令牌（/admin 管理页）签名密钥。未配置时拒绝签发管理令牌。
PLATFORM_ADMIN_SESSION_SECRET=

# Platform 用户 JWT 签名密钥（HS256，登录态令牌）。必须设置，否则 Platform 无法启动。
JWT_SECRET_KEY=

# Platform 用户 API Key 加密密钥（Fernet 格式，直接用于加解密用户密钥）。
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：一旦投入使用不可更换，否则已存储的用户密钥将无法解密。
PLATFORM_ENCRYPT_KEY=


# ============================================================================
# 3. PostgreSQL 数据库（仅支持 PostgreSQL 15+，无 SQLite 模式）
# ============================================================================
# --- Gateway 数据库（网关自身读写）---
# PG_PASSWORD 为必填：缺失时 Gateway 启动直接报错。
PG_HOST=localhost
PG_PORT=5432
PG_DB=aqua_gateway
PG_USER=aqua
PG_PASSWORD=

# --- Platform 数据库（用户平台读写）---
PG_PLATFORM_HOST=localhost
PG_PLATFORM_PORT=5432
PG_PLATFORM_DB=aqua_platform
PG_PLATFORM_USER=aqua
PG_PLATFORM_PASSWORD=

# --- Platform 跨库访问 Gateway 数据库（用户控制台读取网关侧用量/桶监控）---
PG_GATEWAY_HOST=localhost
PG_GATEWAY_PORT=5432
PG_GATEWAY_DB=aqua_gateway
PG_GATEWAY_USER=aqua
PG_GATEWAY_PASSWORD=

# 部署前先建库和用户（示例）：
#   CREATE USER aqua WITH PASSWORD '强密码';
#   CREATE DATABASE aqua_gateway OWNER aqua;
#   CREATE DATABASE aqua_platform OWNER aqua;


# ============================================================================
# 4. Platform 行为开关
# ============================================================================
# Platform 调用 Gateway 的基础地址。默认本机部署无需修改。
GW_BASE_URL=http://127.0.0.1:8000

# 登录 Cookie 是否仅 HTTPS 传输：1=仅 HTTPS（默认，生产必须），0=允许 HTTP（仅本地调试）。
SESSION_COOKIE_SECURE=1

# 是否开放注册：1=开放（默认），0=关闭注册入口。
REGISTRATION_OPEN=1


# ============================================================================
# 5. Gateway 行为开关
# ============================================================================
# 信任反向代理头（X-Forwarded-For 等）：经 Nginx/Caddy 等反代部署时设为 1，
# 否则网关记录的客户端 IP 将全部是反代地址（127.0.0.1）。直连部署设为 0。
AQUA_TRUST_PROXY_HEADERS=0

# 商用检测监控名单（逗号分隔的客户端名称，不区分大小写）。留空表示无监控名单。
AQUA_WATCHLIST=

# 错误响应调试模式：1=在错误响应中返回内部异常详情（仅调试用，生产保持 0）。
AQUA_DEBUG_ERRORS=0


# ============================================================================
# 6. CORS 与邮件（可选）
# ============================================================================
# 【共用】CORS 白名单（逗号分隔的完整 Origin）。保持与实际访问域名一致，
# 切勿使用 * （与 credentials 不兼容）。
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8000

# SMTP 邮件服务（注册验证码、维护通知）。不需要邮件功能可全部留空。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
