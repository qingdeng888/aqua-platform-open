# ============================================================================
# AQUA Gateway 环境变量模板
# ----------------------------------------------------------------------------
# 使用方法：cp .env.example .env 后逐项填写。所有密钥/密码务必使用随机强值。
# 本文件已列入 .gitignore（.env 严禁提交到仓库），也在 .dockerignore 中（不进镜像层）。
#
# 加载与优先级：
#   网关启动时加载「仓库根目录」的 .env（容器内为 /app/.env）；load_dotenv 不覆盖
#   已存在的环境变量，因此优先级为「容器/systemd 传入的环境变量 > 本文件」。
#   除 AQUA_TRUST_PROXY_HEADERS（每请求读取）外，其余变量都在模块导入时读取一次，
#   改动后必须重启进程/容器才生效。建议 chmod 600 .env。
#
# 本文件共 14 项应用变量 + 6 项 Docker 专用变量（第 6 节，应用本身不读）。
#
# 生成随机值：
#   随机令牌   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   bcrypt哈希 见下方「管理员密码」说明
# ============================================================================


# ============================================================================
# 1. 管理员密码（网关控制台 /admin 与 SQLAdmin 面板 /gw/dbadmin）
# ============================================================================
# 优先级：ACU_ADMIN_PASSWORD_HASH（bcrypt 哈希，推荐） > ACU_ADMIN_PASSWORD（明文，
# 恒定时间比较回退）。两者只配置其一即可，同时配置时 HASH 优先。
#
# 生成 bcrypt 哈希（12 rounds）：
#   python3 -c "import bcrypt; print(bcrypt.hashpw('你的密码'.encode(), bcrypt.gensalt(rounds=12)).decode())"
#
# 取值与行为：
#   ACU_ADMIN_PASSWORD_HASH  形如 $2b$12$...（60 字符）。控制台 Admin API（/gw/admin/*）
#                            只认这一项：未配置则进程启动即 RuntimeError [FATAL] 退出。
#                            哈希格式非法（盐/长度不符）按配置错误处理，一律拒绝登录。
#   ACU_ADMIN_PASSWORD       明文密码，仅在 HASH 未配置时作为 SQLAdmin 面板的回退，
#                            对 Admin API 无效。两项都为空 → 面板启动打 [FATAL] 并禁用登录。
#
# ⚠️ Docker 用户必读：bcrypt 哈希含 `$`，而 docker compose 会对 env_file 里的
# `$xxx` 做变量插值——不加引号会把哈希悄悄截断（实测 $2b$12$bdJq... 变成
# $2b$12.yz...），表现为配置看着没问题但管理员密码怎么都登不上。
# 因此哈希值请用单引号包裹（python-dotenv 会自动剥掉引号，裸机部署同样适用）：
#   ACU_ADMIN_PASSWORD_HASH='$2b$12$替换为你自己的哈希'
ACU_ADMIN_PASSWORD_HASH=
ACU_ADMIN_PASSWORD=


# ============================================================================
# 2. 会话签名密钥
# ============================================================================
# SQLAdmin 面板（/gw/dbadmin）的 Session 签名密钥，建议 32 字节以上随机串：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 未设置时每次启动生成临时随机值并打 warning，重启后所有面板登录会话失效
#（不影响控制台 /admin，后者用的是 HMAC 签名的管理 Token）。
ADMIN_SESSION_SECRET=


# ============================================================================
# 3. PostgreSQL 数据库（仅支持 PostgreSQL 15+，无 SQLite 模式）
# ============================================================================
# PG_PASSWORD 为必填：缺失时首次建连接池即报 RuntimeError [FATAL]（惰性校验，
# 纯函数导入/测试不受影响）；Docker 下缺失会让 docker compose up 直接中止。
# Docker 部署时这三项（PG_DB/PG_USER/PG_PASSWORD）同时用于初始化 db 容器，
# PG_HOST 会被 compose 覆盖为服务名 db，此处取值仅裸机部署生效。
# 数据库跑在宿主机而网关在容器里时，PG_HOST 填 host.docker.internal（compose 已配
# host-gateway 映射），填 127.0.0.1 指向的是容器自身。
PG_HOST=localhost
PG_PORT=5432
PG_DB=aqua_gateway
PG_USER=aqua
PG_PASSWORD=

# 部署前先建库和用户（示例）：
#   CREATE USER aqua WITH PASSWORD '强密码';
#   CREATE DATABASE aqua_gateway OWNER aqua;

# psycopg2 连接池大小（整数，实际取 max(5, 本值)，minconn 固定为 5；默认 30）。
# 填非数字会导致启动 ValueError。
GW_DB_POOL_SIZE=30


# ============================================================================
# 4. 网关行为开关
# ============================================================================
# 信任反向代理头（CF-Connecting-IP / X-Forwarded-For）以获取真实客户端 IP。
#   1 / true / yes（不区分大小写）= 强制信任，适用于 Cloudflare 等「对端也是公网 IP」
#                                   的全程代理场景；
#   其余值（含 0、留空）        = auto：对端为私网/回环（Nginx、Caddy 等本机反代）时
#                                   仍会解析上述头，公网直连则忽略一切可伪造头。
# 注意 auto 不等于「完全不信任」，本机反代场景无需改动此项。
AQUA_TRUST_PROXY_HEADERS=0

# 商用检测监控名单（逗号分隔的客户端名称，读取时自动去空格并转小写）。留空表示无监控名单。
AQUA_WATCHLIST=

# 错误响应调试模式：严格等于 1 才开启（true/yes 无效），开启后错误响应返回内部
# 异常详情。仅调试用，生产必须保持 0。
AQUA_DEBUG_ERRORS=0

# 文档解析输入大小上限（字节，默认 20MB = 20971520）。
# 另有三项硬编码防护不可配：PDF ≤ 500 页、zip 膨胀比 ≤ 100、zip 条目数 ≤ 200。
LOBSTER_MAX_BYTES=20971520


# ============================================================================
# 5. CORS（可选）
# ============================================================================
# CORS 白名单：逗号分隔的完整 Origin（含协议与端口）。与 credentials 同用，
# 切勿使用 *。默认 http://localhost:8000。
# ⚠️ 解析为纯 split(",") 不做去空格，逗号后不能有空格：
#   正确  CORS_ALLOWED_ORIGINS=https://a.com,https://b.com
#   错误  CORS_ALLOWED_ORIGINS=https://a.com, https://b.com   ← " https://b.com" 永不匹配
# 改了 GW_PORT 或访问域名要同步这里。
CORS_ALLOWED_ORIGINS=http://localhost:8000


# ============================================================================
# 6. Docker 部署（docker-compose.yml 专用，应用本身不读；裸机部署可忽略本节）
# ============================================================================
# 容器内网关固定监听 8000，本节只控制宿主侧的映射与时区。
#
# GW_BIND：宿主监听地址。127.0.0.1=仅本机可访问（默认，最安全）；
#          0.0.0.0=对局域网/公网暴露，请自行叠加反代、HTTPS 与防火墙。
GW_BIND=127.0.0.1

# GW_PORT：宿主端口。改动后记得同步上面的 CORS_ALLOWED_ORIGINS 与反代 proxy_pass。
GW_PORT=8000

# TZ：gateway 容器时区，只影响容器日志的时间显示。
# db 容器固定 TZ/PGTZ=UTC；写库时间戳恒为 UTC Z 格式（展示端按浏览器本地时区渲染），
# 不受此项影响，宿主与容器时区不一致也不会算错统计窗口。
TZ=Asia/Shanghai

# PG_EXPOSE_PORT：把数据库暴露到宿主 127.0.0.1 的端口（默认 5432），
# 仅在取消 docker-compose.yml 中 db.ports 那两行注释后才生效；默认全程不暴露。
#PG_EXPOSE_PORT=5432

# GW_IMAGE / GW_IMAGE_TAG：网关镜像地址与标签（CI 每次推送自动发布到 GHCR）。
# 默认拉 latest；生产建议锁版本，如 GW_IMAGE_TAG=v12.1.0 或 sha-a1b2c3d。
# fork 到自己仓库或改用私有 registry 时只改这里，不必动 docker-compose.yml。
# 本机源码构建（-f docker-compose.local.yml）时这两项被覆盖层忽略。
#GW_IMAGE=ghcr.io/qingdeng888/aqua-platform-open
#GW_IMAGE_TAG=latest

# 数据库数据存放于命名卷 pgdata。修改 PG_USER/PG_PASSWORD/PG_DB 后，
# 只有删除该卷（docker compose down -v，会丢数据）才会按新值重新初始化
#（PostgreSQL 官方镜像仅在数据目录为空时读这些变量）。

